{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",
    "lib": ["ES2021"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    
    "rootDir": "./src",
    "outDir": "./dist",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": ["node"],
    "sourceMap": true,
    "incremental": true,
    "forceConsistentCasingInFileNames": true,

    // --- CONFIGURACIÓN CRÍTICA PARA COMPILACIÓN ---
    "baseUrl": "./src", // La base de búsqueda es la carpeta src
    "paths": {
      // Cuando importamos 'src/...' o cualquier cosa, la busca en la base (src)
      "src/*": ["*"] 
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "**/*.spec.ts"]
}