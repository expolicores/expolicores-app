// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------
enum Role {
  USER
  ADMIN
  BUSINESS
}

enum OrderStatus {
  RECIBIDO
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

// ---------- Modelos ----------
model User {
  id   Int    @id @default(autoincrement())
  name String @default("Cliente")

  // Login/Contacto
  email    String? @unique
  phone    String? @unique
  password String?

  role Role @default(USER)

  // Verificación
  isPhoneVerified Boolean @default(false)
  isEmailVerified Boolean @default(false)

  // OTP-first
  otpCodeHash   String?
  otpExpiresAt  DateTime?
  lastOtpSentAt DateTime?

  // Relaciones
  orders                  Order[]
  addresses               Address[]
  favorites               Favorite[]
  emailVerificationTokens EmailVerificationToken[] // 👈 campo inverso requerido

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  total     Float
  status    OrderStatus @default(RECIBIDO)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user          User              @relation(fields: [userId], references: [id])
  items         OrderItem[]
  notifications NotificationLog[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Int
  b2bPrice    Int      @default(0)
  stock       Int
  description String
  imageUrl    String?
  category    String?  @db.VarChar(64)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
  favorites  Favorite[]

  @@index([category])
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  label        String
  recipient    String
  phone        String
  line1        String
  line2        String?
  neighborhood String?
  city         String   @default("Villa de Leyva")
  state        String   @default("Boyacá")
  country      String   @default("CO")
  lat          Float?
  lng          Float?
  notes        String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model NotificationLog {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  channel String  @default("WHATSAPP") // por si luego agregas email/sms
  type    String // "ORDER_CREATED" | "STATUS_EN_CAMINO" | "STATUS_ENTREGADO" | "STATUS_CANCELADO"
  sid     String? // SID Twilio
  ok      Boolean
  error   String?
  to      String? // E.164 destino

  createdAt DateTime @default(now())

  @@unique([orderId, type]) // evita duplicados del mismo tipo por orden
  @@index([orderId, createdAt])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], name: "favorite_user_product_unique")
  @@index([userId])
  @@index([productId])
}

// (Opcional / legado) OTP por email si decides conservarlo
model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  code       String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  requestIp  String?

  @@index([email])
  @@index([requestIp], map: "EmailOtp_requestIp_idx")
}

// ---------- Idempotencia ----------
model IdempotencyKey {
  key       String   @id // valor del header Idempotency-Key
  orderId   Int?
  status    String   @default("PENDING") // PENDING | DONE | FAILED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status, createdAt])
}
