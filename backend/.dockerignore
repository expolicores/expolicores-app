# backend/.dockerignore

# Mantén visible el Dockerfile (NO lo ignores)
!Dockerfile

# Dependencias y artefactos
node_modules
dist
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# VCS / cache
.git
.gitignore
.cache
coverage
tmp
.DS_Store

# Env files (no subir secretos al contexto)
.env
.env.*
**/.env
**/.env.*