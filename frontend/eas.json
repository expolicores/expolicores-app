{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "production": {
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium",
        "autoIncrement": "buildNumber"
      },
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "EXPO_DEBUG": "1"
      }
    }
  },
  "submit": { "production": {} }
}
