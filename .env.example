# Runtime
NODE_ENV=development
PORT=3000
BACKEND_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:19006,http://localhost:5173

# Database
# OJO: URL-encode en user/pass si tienen caracteres especiales
DATABASE_URL=postgresql://user:password@localhost:5432/expolicores

# JWT tokens
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_EXPIRES=15m
REFRESH_EXPIRES_DAYS=30

# OTP delivery
SEND_WHATSAPP_NOTIFS=true
OTP_TTL_MIN=10
OTP_MAX_REQ_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=3
OTP_CHANNEL_PRIORITY=whatsapp  # whatsapp|sms
# OTP_DEV_FIXED_CODE=123456     # solo desarrollo
# OTP_INCLUDE_CODE_IN_RESPONSE=true

# Twilio (SMS/WhatsApp)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890
TWILIO_SMS_FROM=+1234567890

# Email OTP (si se usa)
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_FROM=noreply@expolicores.com

# Observabilidad / DX
SWAGGER_ENABLED=true
LOG_LEVEL=log          # log|debug|warn|error
THROTTLE_TTL=60        # seg
THROTTLE_LIMIT=20      # req por TTL
TRUST_PROXY=false      # true si hay proxy/cdn delante
